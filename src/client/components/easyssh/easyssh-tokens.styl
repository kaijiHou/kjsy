// EasySSH Design Tokens —— 全局设计变量（克制现代感，深色默认）
// 深色：柔和深灰（非纯黑）；亮色：干净浅灰
:root
  // 背景层级
  --bg-primary: #1c1d21
  --bg-secondary: #222329
  --bg-terminal: #191a1e
  --surface: #282a31
  --surface-hover: #2e3038
  --surface-active: #33353e

  // 边框（低对比）
  --border: rgba(255, 255, 255, 0.07)
  --border-strong: rgba(255, 255, 255, 0.14)

  // 文字层级
  --text-primary: #e6e6e9
  --text-secondary: #9c9da6
  --text-tertiary: #6d6e78

  // 语义色（单一 accent）
  --accent: #4f8cff
  --accent-hover: #6ba0ff
  --accent-soft: rgba(79, 140, 255, 0.12)
  --success: #4caf7d
  --success-soft: rgba(76, 175, 125, 0.12)
  --danger: #e06161
  --danger-soft: rgba(224, 97, 97, 0.12)
  --warning: #d9a13b
  --warning-soft: rgba(217, 161, 59, 0.12)

  // 形状与间距
  --radius: 8px
  --radius-lg: 12px
  --sidebar-width: 240px

  // 字体
  --font-body: 13px
  --font-title: 14px
  --font-small: 12px

// 亮色主题（后续 Settings 切换使用）
[data-theme='light']
  --bg-primary: #f6f6f8
  --bg-secondary: #efeff2
  --surface: #ffffff
  --surface-hover: #f2f2f5
  --surface-active: #e9e9ee
  --border: rgba(0, 0, 0, 0.08)
  --border-strong: rgba(0, 0, 0, 0.16)
  --text-primary: #1c1d21
  --text-secondary: #5c5e66
  --text-tertiary: #90929a
  --accent: #2f6feb
  --accent-hover: #1e5fd8
  --accent-soft: rgba(47, 111, 235, 0.1)
  --success: #2e9e63
  --success-soft: rgba(46, 158, 99, 0.1)
  --danger: #d94f4f
  --danger-soft: rgba(217, 79, 79, 0.1)
  --warning: #c08a2a
  --warning-soft: rgba(192, 138, 42, 0.1)
