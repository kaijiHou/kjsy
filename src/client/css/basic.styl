@require './includes'
@require './includes/theme'

body
  overflow hidden
  background var(--main)
  font-size 12px
  line-height 1.5715
  font-family -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'
  font-variant: tabular-nums
  color var(--text)

// 挂载容器固定视口高度：避免 flex 高度链在内容驱动下崩溃
// （否则 splitter 拖动后 Terminal 高度会被压缩到 min-content）
#container
  height: 100vh
  overflow: hidden

#container > div
  height: 100%

#outside-context
  height: 100%

::-webkit-scrollbar
  background transparent
  width 7px

.term-wrap:hover
  ::-webkit-scrollbar
    width 12px

::-webkit-scrollbar-track
  -webkit-box-shadow none

::-webkit-scrollbar-thumb
  background-color var(--primary)
  outline none

::-webkit-scrollbar-corner
  background-color transparent

.common-err
  max-height 100px
  overflow-y scroll
  overflow-x hidden
  word-break break-all

a
  color var(--text)
  &:hover
    color var(--text-dark)

.cap
  text-transform capitalize

// shared drag-and-drop reorder indicators (vertical lists)
// first half of the target  => insert before => top edge
// second half of the target => insert after  => bottom edge
// (tabs use their own horizontal left/right line indicators)
.dnd-before
  box-shadow inset 0 2px 0 0 var(--primary)
.dnd-after
  box-shadow inset 0 -2px 0 0 var(--primary)
// antd table rows: box-shadow on <tr> is not rendered, apply on cells
tr.dnd-before > td
  box-shadow inset 0 2px 0 0 var(--primary)
tr.dnd-after > td
  box-shadow inset 0 -2px 0 0 var(--primary)

.sync-data-compare
  .sync-suggest-action
    color var(--success)
    font-weight 500