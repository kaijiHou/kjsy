{
  "appId": "org.kjsy.easyssh",
  "directories": {
    "app": "work/app",
    "output": "dist",
    "buildResources": "node_modules/@electerm/electerm-resource/build-res"
  },
  "electronLanguages": [
    "en-US"
  ],
  "asar": true,
  "executableName": "EasySSH",
  "npmRebuild": false,
  "electronDist": "node_modules/electron/dist",
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "win": {
    "target": [
      "dir"
    ],
    "icon": "build/icons/EasySSH.ico",
    "signAndEditExecutable": false,
    "publish": {
      "provider": "github",
      "owner": "kaijiHou",
      "repo": "kjsy",
      "channel": "${env.WORKFLOW_NAME}"
    }
  },
  "protocols": [
    {
      "name": "SSH Protocol",
      "schemes": [
        "ssh"
      ]
    },
    {
      "name": "Telnet Protocol",
      "schemes": [
        "telnet"
      ]
    },
    {
      "name": "RDP Protocol",
      "schemes": [
        "rdp"
      ]
    },
    {
      "name": "VNC Protocol",
      "schemes": [
        "vnc"
      ]
    },
    {
      "name": "Serial Protocol",
      "schemes": [
        "serial"
      ]
    },
    {
      "name": "Spice Protocol",
      "schemes": [
        "spice"
      ]
    },
    {
      "name": "EasySSH Protocol",
      "schemes": [
        "easyssh"
      ]
    }
  ],
  "nsis": {
    "oneClick": false,
    "artifactName": "${productName}-${version}-${os}-${arch}-installer.${ext}",
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": "dmg",
    "icon": "build/icons/easyssh-512x512.png",
    "publish": {
      "provider": "github",
      "owner": "kaijiHou",
      "repo": "kjsy",
      "channel": "${env.WORKFLOW_NAME}"
    },
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "./build/entitlements.plist",
    "entitlementsInherit": "./build/entitlements.plist",
    "notarize": true
  },
  "dmg": {
    "contents": [
      {
        "x": 110,
        "y": 190
      },
      {
        "x": 440,
        "y": 190,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "linux": {
    "category": "Development;System;TerminalEmulator",
    "icon": "build/icons/linux",
    "target": [
      "rpm",
      "deb",
      "AppImage",
      "tar.gz",
      "snap"
    ],
    "publish": {
      "provider": "github",
      "owner": "kaijiHou",
      "repo": "kjsy",
      "channel": "${env.WORKFLOW_NAME}"
    },
    "desktop": {
      "entry": {
        "StartupWMClass": "EasySSH"
      }
    }
  },
  "snap": {
    "confinement": "classic",
    "publish": {
      "provider": "github",
      "owner": "kaijiHou",
      "repo": "kjsy",
      "channel": "${env.WORKFLOW_NAME}"
    }
  },
  "deb": {
    "afterInstall": "build/bin/linux-deb-after-build.sh"
  }
}
